# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Every variable here is OPTIONAL — the app runs without any of them. They only
# enable live GE prices and the in-app feedback email relay. There is no database
# and no login: the app stores no user data.

# --- OSRS Wiki prices -------------------------------------------------------
# The OSRS Wiki Real-time Prices API requires a descriptive User-Agent with
# contact info; generic UAs may be rate-limited or blocked. Set this to a real
# email or Discord handle the wiki operators can reach you at.
# See https://oldschool.runescape.wiki/w/RuneScape:Real-time_Prices
WIKI_USER_AGENT_CONTACT=your-email@example.com

# --- Feedback email (optional) ----------------------------------------------
# The in-app feedback button emails messages to you via Resend (resend.com).
# Leave RESEND_API_KEY blank in dev: feedback is printed to the server console
# instead of being emailed.
RESEND_API_KEY=
# Verified "from" address. Defaults to Resend's sandbox sender if unset.
EMAIL_FROM=
# Where feedback messages are delivered.
FEEDBACK_TO=
