# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string (Phase 6.1+). Get one free from Neon (neon.tech):
#   create a project → copy the "Pooled connection" string.
# Vercel Postgres injects POSTGRES_URL automatically in production; either name works.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Added in later Phase 6 sub-phases (leave blank for now) ---

# Auth.js (6.2): a random secret. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Resend API key for sending magic-link emails (6.2). In dev the link is logged
# to the console, so this can stay blank until deploy.
RESEND_API_KEY=
